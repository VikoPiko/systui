<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI for systui (WiX Toolset 5.0.x, MS-RL licence: pin `wix` to 5.0.2; v7+ adds a paid
  maintenance fee). Installs to %LOCALAPPDATA%\Programs\systui, needs NO administrator rights, and
  offers an optional feature that adds that folder to the USER Path. Nothing machine-wide is touched.

  Build with scripts/build-msi.ps1 (it passes Version, ExePath and DocDir).
  Install without PATH:  msiexec /i systui.msi ADDLOCAL=Main
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="systui"
           Manufacturer="The systui authors"
           Version="$(Version)"
           UpgradeCode="A25FED58-82D7-4CA2-94CD-765E6593E327"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="systui - fast, read-only terminal system monitor" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of systui is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Icon for the Start Menu shortcut and the Apps & features entry (scripts/make-icon.ps1). -->
    <Icon Id="SystuiIcon.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SystuiIcon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="systui" />
      </Directory>
    </StandardDirectory>

    <!-- Files. A per-user package must key every component on a HKCU value (ICE38/ICE64). -->
    <Component Id="AppFiles" Directory="INSTALLFOLDER" Guid="FE8969B5-B40D-4E2B-95C8-7BBAF11BD273">
      <RegistryValue Root="HKCU" Key="Software\systui" Name="InstallDir" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <File Id="SystuiExe" Source="$(ExePath)" Name="systui.exe" />
      <File Id="Readme" Source="$(DocDir)\README.md" />
      <File Id="License" Source="$(DocDir)\LICENSE" />
      <File Id="Changelog" Source="$(DocDir)\CHANGELOG.md" />
      <File Id="ExampleConfig" Source="$(DocDir)\config\config.example.toml" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- Optional: add the install folder to the USER Path (undone again on uninstall). -->
    <Component Id="UserPath" Directory="INSTALLFOLDER" Guid="7327E685-4CC4-49E3-AB89-2140CADD2173">
      <RegistryValue Root="HKCU" Key="Software\systui" Name="PathEntryAdded" Type="integer"
                     Value="1" KeyPath="yes" />
      <Environment Id="UserPathEntry" Name="PATH" Action="set" Part="last" System="no"
                   Permanent="no" Value="[INSTALLFOLDER]" />
    </Component>

    <!-- Start Menu shortcut (per user). systui is a TUI, so the shortcut opens it in Windows Terminal
         when wt.exe is available and otherwise in a new classic console window. The helper cmd is
         started minimised and exits right after `start`, so no stray window is left behind.
         Hotkey="1619" = 0x0653 = Ctrl+Alt+S (high byte 0x06 = Ctrl|Alt, low byte 0x53 = 'S'). Windows
         only honours shortcut hotkeys with a Ctrl+Alt prefix and only for Start Menu/Desktop
         shortcuts, so no resident process is needed. -->

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="systui" />
    </StandardDirectory>
    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="3C1D5B0E-6A52-4F0B-9D7E-2B8A4C61F0A9">
      <RegistryValue Root="HKCU" Key="Software\systui" Name="StartMenuShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
      <Shortcut Id="SystuiShortcut" Name="systui"
                Description="systui - terminal system monitor"
                Target="[SystemFolder]cmd.exe"
                Arguments="/d /s /c &quot;where wt.exe &gt;nul 2&gt;&amp;1 &amp;&amp; (start &quot;&quot; wt.exe &quot;[INSTALLFOLDER]systui.exe&quot;) || start &quot;&quot; &quot;[INSTALLFOLDER]systui.exe&quot;&quot;"
                WorkingDirectory="INSTALLFOLDER"
                Icon="SystuiIcon.ico"
                Hotkey="1619"
                Show="minimized" />
      <RemoveFolder Id="RemoveStartMenuDir" Directory="StartMenuDir" On="uninstall" />
    </Component>

    <Feature Id="Main" Title="systui" Level="1" AllowAbsent="no">
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="AddToPath" Title="Add systui to the user PATH" Level="1">
        <ComponentRef Id="UserPath" />
      </Feature>
    </Feature>

  </Package>
</Wix>
